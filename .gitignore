# Bytecode / caches
__pycache__/
*.pyc

# Extracción temporal de adjuntos de .eml (se regenera en cada corrida)
salida/_tmp_adjuntos/

# Editores / SO
.vscode/
.idea/
Thumbs.db
.DS_Store

# pytest
.pytest_cache/

# Resultados por cliente: contienen INE (imágenes), CURP y datos personales -> no se versionan
# (las carpetas antiguas ya versionadas siguen rastreadas; esto solo evita agregar las nuevas)
salida/*/
!salida/.gitkeep
